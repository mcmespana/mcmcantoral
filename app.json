{
  "expo": {
    "name": "MCM Cantoral",
    "slug": "mcmcantoral",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mcmcantoral",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.familiaconsolacion.mcmcantoral",
      "infoPlist": {
        "CFBundleDisplayName": "MCM Cantoral",
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Repertorio MCM",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.mcmespana.mcmcantoral.playlist",
              "com.mcmespana.mcmapp.playlist"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.mcmespana.mcmcantoral.playlist",
            "UTTypeDescription": "Repertorio MCM",
            "UTTypeConformsTo": ["public.data", "public.json"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["mcm"],
              "public.mime-type": ["application/octet-stream"]
            }
          }
        ],
        "NSLocalNetworkUsageDescription": "MCM Cantoral usa la red local para seguir al maestro por la wifi del coro: así las canciones pasan solas aunque no haya internet.",
        "NSBonjourServices": ["_mcmcantoral._tcp"],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.mcmespana.mcmapp.playlist",
            "UTTypeDescription": "MCM Playlist",
            "UTTypeConformsTo": ["public.data", "public.json"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["mcm"],
              "public.mime-type": ["application/octet-stream"]
            }
          }
        ]
      },
      "appleTeamId": "5P53S6QB23",
      "associatedDomains": ["applinks:mcmcantoral.expo.app"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#0B0B0C"
      },
      "package": "com.mcmespana.mcmcantoral",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "scheme": "mcmcantoral"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.mcm"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.mcm"
            }
          ]
        },
        {
          "autoVerify": true,
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "scheme": "https",
              "host": "mcmcantoral.expo.app",
              "pathPrefix": "/playlist"
            },
            {
              "scheme": "https",
              "host": "mcmcantoral.expo.app",
              "pathPrefix": "/coro"
            },
            {
              "scheme": "https",
              "host": "mcmcantoral.expo.app",
              "pathPrefix": "/cancion"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-light.png",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0C"
        }
      ],
      "expo-asset",
      ["expo-build-properties"],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialIcons.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf"
          ]
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "MCM Cantoral usa la cámara para escanear los códigos QR de repertorios y directos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "MCM Cantoral usa el micrófono para el afinador: escucha tu instrumento para decirte si está afinado. El sonido se analiza en el móvil y no se guarda ni se envía.",
          "iosBackgroundMode": false,
          "androidPermissions": ["android.permission.RECORD_AUDIO"],
          "androidForegroundService": false,
          "enableFFmpeg": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MCM Cantoral usa tus fotos para leer la letra de una canción desde una foto en el editor del cantoral.",
          "cameraPermission": "MCM Cantoral usa la cámara para escanear los códigos QR de repertorios y directos, y para fotografiar la letra de una canción en el editor.",
          "microphonePermission": "MCM Cantoral usa el micrófono para el afinador: escucha tu instrumento para decirte si está afinado. El sonido se analiza en el móvil y no se guarda ni se envía."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef39d4f3-3941-4d46-bfc2-7a9403fabb2d"
      }
    },
    "owner": "mcmespana"
  }
}
