# Variables que lee Expo CLI. Copia este fichero a `.env.local` y rellénalo.

# Firebase: las MISMAS que MCM App (misma base de datos; SDK web, no hace falta
# registrar apps nuevas en Firebase).
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-db-url
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Proyecto EAS NUEVO de MCM Cantoral (`eas init`). Sin él no hay OTA: así es
# imposible publicar por error en el proyecto de MCM App.
EAS_PROJECT_ID=

# Sentry y Aptabase: instalados y APAGADOS hasta la Fase 5 (D-15). Sin valor
# no se manda nada.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APTABASE_KEY=
# Solo para el BUILD (subida de source maps), sin prefijo EXPO_PUBLIC_:
# SENTRY_ORG=mcmespana
# SENTRY_PROJECT=mcm-cantoral
# SENTRY_AUTH_TOKEN=  (secreto — NUNCA commitear)
